# URL du projet Supabase (Settings > API). Publique.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Clé "anon" (Settings > API). Publique, protégée par les policies RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé "service_role" : SERVEUR UNIQUEMENT (actions admin, stockage + signature du cookie).
# Obligatoire sur Vercel pour les fonctions admin. Ne jamais préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Code famille demandé à l'entrée (ex. 4 à 6 chiffres)
SITE_PIN=123456
# URL publique du site (ex. https://hub-courses.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
